    def focus_evidence_inventory():
        """
        Switches the inventory to the evidence tab and makes sure it's on
        screen, so the player has something to pick a destination tube from.
        """
        global selected_inventory
        selected_inventory = evidence
        if not renpy.get_screen("inventory"):
            renpy.show_screen("inventory")
            renpy.hide_screen("open_inv")


    def start_transfer():
        """
        Asks the player whether they want to move the tube's liquid contents
        or its physical spin column, then focuses the evidence inventory so
        they can pick a destination tube.
        """
        global transfer_source, transfer_mode

        if curr_sample is None:
            renpy.notify("Select a sample first.")
            return

        mode = renpy.invoke_in_new_context(renpy.call_screen, "choose_transfer_type")

        if mode is "cancel":
            cancel_transfer()
        elif mode == "spin_column" and not curr_sample.has_spin_column:
            renpy.notify(f"{curr_sample.label} doesn't have a spin column to transfer.")
            return
        else:
            transfer_source = curr_sample
            transfer_mode = mode
            focus_evidence_inventory()
            renpy.notify(
                "Select a tube to transfer the spin column into."
                if mode == "spin_column" else
                "Select a tube to transfer the solution into."
            )
 

    def cancel_transfer():
        global transfer_source, transfer_mode
        transfer_source = None
        transfer_mode = None
        renpy.notify("Transfer cancelled.")


    def attempt_transfer(item):
        global transfer_source, transfer_mode

        destination = getattr(item, "instance", None)

        if not isinstance(destination, Tube_2ml):
            renpy.notify("You can only transfer into a sample tube.")
            return

        if destination is transfer_source:
            renpy.notify("Choose a different tube to transfer into.")
            return

        if transfer_mode == "spin_column":
            transfer_spin_column(transfer_source, destination)
        else:
            transfer_solution(transfer_source, destination)

        transfer_source = None
        transfer_mode = None


    def check_binding(source):
        value = 0.1

        #Checks if there is even distribution for uniform reaction with silica
        if source.uniformly_mixed:
            value += 0.28

        if source.has_ethanol:
            value += 0.28
        
        if source.get_total_volume() <= 1350:
            value += 0.28

        return value


    def transfer_solution(source, destination):
        """
        Moves the liquid contents of source into destination. If destination
        has a spin column, the bound fraction (per check_binding) sticks to
        the column as _mass_DNA_bound rather than staying free in solution;
        the rest passes through as flow-through, same as before.
        """
        if source.has_spin_column:
            renpy.notify("You need to do something about the spin column first!")
            return

        #This is an incredibly inelegant hardcode but you never really transfer more than half a tube of sample
        transfer_volume = min(700, source.get_total_volume())

        if not destination.has_space(transfer_volume):
            renpy.notify(f"{destination.label} doesn't have enough space for that transfer!")
            return


        destination.uniformly_mixed = source.uniformly_mixed
        destination.has_AE = source.has_AE
        destination.has_AW1 = source.has_AW1
        destination.has_AW2 = source.has_AW2
        destination.has_ethanol = source.has_ethanol

        #If there are still active DNAses you will also expose the contents of the new tube to them
        destination._decay_rate = source._decay_rate


        #What percent of the source volume is transferred?
        #TODO If time permits find a way to punish not transferring uniform solution by uneven DNA distribution (Probably wont have time for this :)
        percentage_transferred = transfer_volume / source.get_total_volume()
        
        #DNA still trapped in cells and solvent will not adhere to spin column and transfer the same always
        #Additionally, I am accutely aware there may be some floating point BS going on here but I think it should be fine.
        destination._mass_DNA += source._mass_DNA * percentage_transferred
        destination._volume_solvent += source._volume_solvent  * percentage_transferred

        source._mass_DNA -= source._mass_DNA * percentage_transferred
        source._volume_solvent -= source._volume_solvent  * percentage_transferred

        #Free DNA will always be transferred as it is in the solution regardless of the presence of spin column.
        destination._mass_DNA_free += source._mass_DNA_free * percentage_transferred 
        source._mass_DNA_free -= source._mass_DNA_free * percentage_transferred


        #Update concentrations to accurately reflect what has gone on
        destination.calculate_concentration_DNA()
        source.calculate_concentration_DNA()

        renpy.notify(f"Transferred solution from {source.label} to {destination.label}.")


    def transfer_spin_column(source, destination):
        """
        Moves the physical spin column - and whatever DNA is currently bound
        to it - out of source and into destination, leaving both tubes'
        liquid contents untouched. Mirrors pulling the column out of the
        collection tube and dropping it into a fresh one.
        """
        if destination.has_spin_column:
            renpy.notify(f"{destination.label} already has a spin column in it.")
            return
        elif destination.get_total_volume() > 0:
            renpy.notify("There is already solution in this tube.")
            return

        destination.has_spin_column = True
        destination._mass_DNA_bound = source._mass_DNA_bound

        source.has_spin_column = False
        source._mass_DNA_bound = 0

        destination.has_chaotropic_salts = source.has_chaotropic_salts
        destination.proteins_washed = source.proteins_washed

        renpy.notify(f"Moved the spin column from {source.label} to {destination.label}.")
    

    DECAY_TICK_SECONDS = 1.0

    def degrade_all_samples():
        """
        Called on a repeating timer to age every sample tube currently in
        the evidence inventory, regardless of which one is selected.
        """
        for item in evidence._inventory:
            instance = getattr(item, "instance", None)
            if isinstance(instance, Tube_2ml):
                instance.degrade(DECAY_TICK_SECONDS)
    
    
