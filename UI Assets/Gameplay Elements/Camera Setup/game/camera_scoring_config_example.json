    "sharpness_scoring": {
      "description": "Measures lens choice and focus quality",
      "lens_correct_points": 15,
      "lens_acceptable_points": 5,
      "focus_optimal_points": 15,
      "focus_acceptable_points": 10
    },

    "completeness_scoring": {
      "description": "Measures required elements presence",
      "all_requirements_met": 10,
      "missing_optional": 7,
      "missing_required": 0,
      "bonus_critical_perfect": 5
